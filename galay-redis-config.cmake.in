@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(galay-kernel 5.0.0 REQUIRED CONFIG)

set(GALAY_REDIS_ENABLE_SSL @GALAY_REDIS_ENABLE_SSL@)
if(GALAY_REDIS_ENABLE_SSL)
    find_dependency(galay-ssl 2.1.0 REQUIRED CONFIG)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/galayRedisConfigTargets.cmake")

check_required_components(galay-redis)
